{% style %}
.u-rctxtniet-wrap{
max-width: 720px;
margin: 0 auto;
padding: 0 24px;
display: flex;
flex-direction: column;
align-items: center;
text-align: center;
}
.u-rctxtniet-badge{
border-radius: 50%;
display: flex;
align-items: center;
justify-content: center;
}
.u-rctxtniet-badge img{
width: 100%;
height: 100%;
object-fit: cover;
}
.u-rctxtniet-eyebrow{
margin: 0;
letter-spacing: 0.05em;
}
.u-rctxtniet-heading *{
margin: 0;
line-height: 1.25;
}
.u-rctxtniet-desc{
margin-left: auto;
margin-right: auto;
line-height: 1.5;
}
.u-rctxtniet-desc p{
margin: 0;
}
.u-rctxtniet-btn{
display: inline-flex;
align-items: center;
justify-content: center;
text-decoration: none;
white-space: nowrap;
}
.u-rctxtniet-review{
display: flex;
align-items: center;
justify-content: center;
gap: 8px;
flex-wrap: wrap;
}
.u-rctxtniet-review-star img{
width: 100%;
height: auto;
display: block;
}
.u-rctxtniet-review-text{
line-height: 1.4;
}
@media(max-width:768px){
.u-rctxtniet-btn{
width:100%
}
}
{% endstyle %}
