{% style %}
.u-rctxtniet-section--{{ section.id }}{
background-color:{{ section.settings.sec_bg_clr }};
padding-top:{{ section.settings.tp_pd }}px;
padding-bottom:{{ section.settings.btm_pd }}px;
}
.u-rctxtniet-section--{{ section.id }} .u-rctxtniet-badge{
background-color:{{ section.settings.badge_bg_clr }};
width:{{ section.settings.badge_sz }}px;
height:{{ section.settings.badge_sz }}px;
padding:{{ section.settings.badge_icon_pd }}px;
margin-bottom:{{ section.settings.badge_m_btm }}px;
}
.u-rctxtniet-section--{{ section.id }} .u-rctxtniet-eyebrow{
color:{{ section.settings.eyebrow_clr }};
font-size:{{ section.settings.eyebrow_sz }}px;
margin-top:{{ section.settings.eyebrow_m_tp }}px;
}
.u-rctxtniet-section--{{ section.id }} .u-rctxtniet-heading {
margin-top:{{ section.settings.heading_m_tp }}px;
}
.u-rctxtniet-section--{{ section.id }} .u-rctxtniet-heading *{
color:{{ section.settings.heading_clr }};
font-size:{{ section.settings.heading_sz }}px;
}
.u-rctxtniet-section--{{ section.id }} .u-rctxtniet-desc{
color:{{ section.settings.desc_clr }};
font-size:{{ section.settings.desc_sz }}px;
margin-top:{{ section.settings.desc_m_tp }}px;
max-width:{{ section.settings.desc_max_w }}px;
}
.u-rctxtniet-section--{{ section.id }} .u-rctxtniet-btn{
background-color:{{ section.settings.btn_bg_clr }};
color:{{ section.settings.btn_txt_clr }};
font-size:{{ section.settings.btn_txt_sz }}px;
padding-top:{{ section.settings.btn_pd_tp }}px;
padding-bottom:{{ section.settings.btn_pd_btm }}px;
padding-left:{{ section.settings.btn_pd_lr }}px;
padding-right:{{ section.settings.btn_pd_lr }}px;
border-radius:{{ section.settings.btn_radius }}px;
margin-top:{{ section.settings.btn_m_tp }}px;
}
.u-rctxtniet-section--{{ section.id }} .u-rctxtniet-review{
margin-top:{{ section.settings.review_m_tp }}px;
}
.u-rctxtniet-section--{{ section.id }} .u-rctxtniet-review-star{
width:{{ section.settings.review_star_w }}px;
}
.u-rctxtniet-section--{{ section.id }} .u-rctxtniet-review-text{
color:{{ section.settings.review_txt_clr }};
font-size:{{ section.settings.review_txt_sz }}px;
}
@media(max-width:768px){
.u-rctxtniet-section--{{ section.id }}{
padding-top:{{ section.settings.tp_pd_mob }}px;
padding-bottom:{{ section.settings.btm_pd_mob }}px;
}
.u-rctxtniet-section--{{ section.id }} .u-rctxtniet-badge{
width:{{ section.settings.badge_sz_mb }}px;
height:{{ section.settings.badge_sz_mb }}px;
}
.u-rctxtniet-section--{{ section.id }} .u-rctxtniet-eyebrow{
font-size:{{ section.settings.eyebrow_sz_mb }}px;
}
.u-rctxtniet-section--{{ section.id }} .u-rctxtniet-heading *{
font-size:{{ section.settings.heading_sz_mb }}px;
}
.u-rctxtniet-section--{{ section.id }} .u-rctxtniet-desc{
font-size:{{ section.settings.desc_sz_mb }}px;
}
.u-rctxtniet-section--{{ section.id }} .u-rctxtniet-review-star{
width:{{ section.settings.review_star_w_mb }}px;
}
.u-rctxtniet-section--{{ section.id }} .u-rctxtniet-review-text{
font-size:{{ section.settings.review_txt_sz_mb }}px;
}
}
{% endstyle %}

<section class="u-rctxtniet-section u-rctxtniet-section--{{ section.id }}">
  <div class="page-width">
    <div class="u-rctxtniet-wrap">
      {% if section.settings.badge_img != blank %}
        <div class="u-rctxtniet-badge">
          <img
            src="{{ section.settings.badge_img | image_url: width: 100 }}"
            width="100%"
            height="100%"
            loading="lazy"
            alt=""
          >
        </div>
      {% endif %}
      {% if section.settings.cnt_eyebrow != blank %}
        <p class="u-rctxtniet-eyebrow">{{ section.settings.cnt_eyebrow }}</p>
      {% endif %}
      {% if section.settings.cnt_heading != blank %}
        <div class="u-rctxtniet-heading">{{ section.settings.cnt_heading }}</div>
      {% endif %}
      {% if section.settings.cnt_desc != blank %}
        <div class="u-rctxtniet-desc">{{ section.settings.cnt_desc }}</div>
      {% endif %}
      {% if section.settings.btn_txt != blank %}
        <a
          {% if section.settings.btn_link != blank %}
            href="{{ section.settings.btn_link }}"
          {% else %}
            href="#"
          {% endif %}
          class="u-rctxtniet-btn"
        >
          {{ section.settings.btn_txt }}
        </a>
      {% endif %}
      {% if section.settings.review_txt != blank %}
        <div class="u-rctxtniet-review">
          {% if section.settings.review_star_img != blank %}
            <span class="u-rctxtniet-review-star">
              <img
                src="{{ section.settings.review_star_img | image_url: width: 200 }}"
                width="100%"
                height="auto"
                loading="lazy"
                alt=""
              >
            </span>
          {% endif %}
          <span class="u-rctxtniet-review-text">{{ section.settings.review_txt }}</span>
        </div>
      {% endif %}
    </div>
  </div>
</section>

