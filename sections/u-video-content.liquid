{% style %}
  .u-vdocont-section--{{ section.id }}{
  background-color:{{ section.settings.sec_bg_clr }};
  padding-top:{{ section.settings.tp_pd }}px;
  padding-bottom:{{ section.settings.btm_pd }}px;
  }
  .u-vdocont-section--{{ section.id }} .u-vdocont-wrap{
  gap:{{ section.settings.col_gap }}px;
  }
  .u-vdocont-section--{{ section.id }} .u-vdocont-video-wrap{
  border-radius:{{ section.settings.vd_radius }}px;
  padding-top:{{ section.settings.vd_height }}%;
  background-color:{{ section.settings.vd_bg_clr }};
  }
  .u-vdocont-section--{{ section.id }} .u-vdocont-play-btn{
  width:{{ section.settings.vd_play_sz }}px;
  height:{{ section.settings.vd_play_sz }}px;
  color:{{ section.settings.vd_play_clr }};
  border-color:{{ section.settings.vd_play_border_clr }};
  border-width:{{ section.settings.vd_play_border_w }}px;
  }
  .u-vdocont-section--{{ section.id }} .u-vdocont-author-avatar{
  background-color:{{ section.settings.au_avatar_bg }};
  }
  .u-vdocont-section--{{ section.id }} .u-vdocont-author-name,
  .u-vdocont-section--{{ section.id }} .u-vdocont-author-followers{
  color:{{ section.settings.au_txt_clr }};
  }
  .u-vdocont-section--{{ section.id }} .u-vdocont-eyebrow{
  color:{{ section.settings.cnt_eyebrow_clr }};
  font-size:{{ section.settings.cnt_eyebrow_sz }}px;
  }
  .u-vdocont-section--{{ section.id }} .u-vdocont-heading{
  font-size:{{ section.settings.cnt_heading_sz }}px;
  color:{{ section.settings.cnt_heading_clr }};
  margin-top:{{ section.settings.cnt_heading_m_tp }}px;
  }
  .u-vdocont-section--{{ section.id }} .u-vdocont-desc-wrap{
  margin-top:{{ section.settings.cnt_desc_m_tp }}px;
  gap:{{ section.settings.cnt_desc_gap }}px;
  }
  .u-vdocont-section--{{ section.id }} .u-vdocont-desc-line{
  background-color:{{ section.settings.cnt_desc_line_clr }};
  width:{{ section.settings.cnt_desc_line_w }}px;
  border-radius:{{ section.settings.cnt_desc_line_radius }}px;
  }
  .u-vdocont-section--{{ section.id }} .u-vdocont-desc-text{
  font-size:{{ section.settings.cnt_desc_sz }}px;
  color:{{ section.settings.cnt_desc_clr }};
  }
  .u-vdocont-section--{{ section.id }} .u-vdocont-usp-list{
  margin-top:{{ section.settings.usp_m_tp }}px;
  gap:{{ section.settings.usp_gap }}px;
  }
  .u-vdocont-section--{{ section.id }} .u-vdocont-usp-icon{
  color:{{ section.settings.usp_icon_clr }};
  background-color:{{ section.settings.usp_icon_bg }};
  width:{{ section.settings.usp_icon_sz }}px;
  height:{{ section.settings.usp_icon_sz }}px;
  }
  .u-vdocont-section--{{ section.id }} .u-vdocont-media-overlay{
  background-color:{{ section.settings.vd_overlay_clr }};
  opacity:{{ section.settings.vd_overlay_opacity | divided_by: 100.0 }};
  }
  .u-vdocont-section--{{ section.id }} .u-vdocont-usp-text{
  font-size:{{ section.settings.usp_txt_sz }}px;
  color:{{ section.settings.usp_txt_clr }};
  }
  .u-vdocont-section--{{ section.id }} .u-vdocont-author-wrap{
  gap:{{ section.settings.au_gap }}px;
  }
  .u-vdocont-section--{{ section.id }} .u-vdocont-author-avatar{
  width:{{ section.settings.au_avatar_sz }}px;
  height:{{ section.settings.au_avatar_sz }}px;
  }
  .u-vdocont-section--{{ section.id }} .u-vdocont-author-initials{
  font-size:{{ section.settings.au_initials_sz }}px;
  color:{{ section.settings.au_initials_clr }};
  }
  .u-vdocont-section--{{ section.id }} .u-vdocont-verified-badge{
  width:{{ section.settings.au_badge_sz }}px;
  height:{{ section.settings.au_badge_sz }}px;
  }
  .u-vdocont-section--{{ section.id }} .u-vdocont-usp-item{
  gap:{{ section.settings.usp_item_gap }}px;
  }
  @media(max-width:768px){
  .u-vdocont-section--{{ section.id }}{
  padding-top:{{ section.settings.tp_pd_mob }}px;
  padding-bottom:{{ section.settings.btm_pd_mob }}px;
  }
  .u-vdocont-section--{{ section.id }} .u-vdocont-heading{
  font-size:{{ section.settings.cnt_heading_sz_mb }}px;
  }
  .u-vdocont-section--{{ section.id }} .u-vdocont-eyebrow{
  font-size:{{ section.settings.cnt_eyebrow_sz_mb }}px;
  }
  .u-vdocont-section--{{ section.id }} .u-vdocont-desc-text{
  font-size:{{ section.settings.cnt_desc_sz_mb }}px;
  }
  .u-vdocont-section--{{ section.id }} .u-vdocont-wrap{
  gap:{{ section.settings.col_gap_mob }}px;
  }
  .u-vdocont-section--{{ section.id }} .u-vdocont-usp-text{
  font-size:{{ section.settings.usp_txt_sz_mb }}px;
  }
  .u-vdocont-section--{{ section.id }} .u-vdocont-video-wrap{
  padding-top:{{ section.settings.vd_height_mob }}%;
  }
  }
{% endstyle %}

<section class="u-vdocont-section u-vdocont-section--{{ section.id }}">
  <div class="page-width">
    <div class="u-vdocont-wrap">
      <div class="u-vdocont-media-col">
        <div class="u-vdocont-video-wrap">
          {% if section.settings.vd_video != blank %}
            <video
              class="u-vdocont-video"
              playsinline
              preload="metadata"
              poster="{% if section.settings.vd_placeholder != blank %}{{ section.settings.vd_placeholder | image_url: width: 800 }}{% endif %}"
            >
              {% for source in section.settings.vd_video.sources %}
                {% if source.format == 'mp4' %}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {% endif %}
              {% endfor %}
            </video>
          {% elsif section.settings.vd_placeholder != blank %}
            <div class="u-vdocont-media-overlay"></div>
            <img
              class="u-vdocont-placeholder"
              src="{{ section.settings.vd_placeholder | image_url: width: 800 }}"
              width="100%"
              height="100%"
              loading="lazy"
              alt="{{ section.settings.au_name | escape }}"
            >
          {% endif %}
          <div class="u-vdocont-media-overlay"></div>
          {% if section.settings.vd_video != blank %}
            <button type="button" class="u-vdocont-play-btn" aria-label="Play video">
              <svg
                class="u-vdocont-play-icon"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="1.2"></circle>
                <path d="M10 8.5L16 12L10 15.5V8.5Z" fill="currentColor"></path>
              </svg>
            </button>
          {% endif %}

          {% if section.settings.au_name != blank or section.settings.au_avatar_img != blank %}
            <div class="u-vdocont-author-wrap">
              <div class="u-vdocont-author-avatar">
                {% if section.settings.au_avatar_img != blank %}
                  <img
                    src="{{ section.settings.au_avatar_img | image_url: width: 80 }}"
                    width="100%"
                    height="100%"
                    loading="lazy"
                    alt="{{ section.settings.au_name | escape }}"
                  >
                {% elsif section.settings.au_initials != blank %}
                  <span class="u-vdocont-author-initials">{{ section.settings.au_initials }}</span>
                {% endif %}
                {% if section.settings.au_verified_icon != blank %}
                  <span class="u-vdocont-verified-badge">
                    <img
                      src="{{ section.settings.au_verified_icon | image_url: width: 40 }}"
                      width="100%"
                      height="100%"
                      loading="lazy"
                      alt="Verified"
                    >
                  </span>
                {% endif %}
              </div>
              <div class="u-vdocont-author-details">
                {% if section.settings.au_name != blank %}
                  <p class="u-vdocont-author-name">{{ section.settings.au_name }}</p>
                {% endif %}
                {% if section.settings.au_followers != blank %}
                  <p class="u-vdocont-author-followers">{{ section.settings.au_followers }}</p>
                {% endif %}
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      <div class="u-vdocont-content-col">
        {% if section.settings.cnt_eyebrow != blank %}
          <p class="u-vdocont-eyebrow">{{ section.settings.cnt_eyebrow }}</p>
        {% endif %}
        {% if section.settings.cnt_heading != blank %}
          <h2 class="u-vdocont-heading">{{ section.settings.cnt_heading }}</h2>
        {% endif %}
        {% if section.settings.cnt_desc != blank %}
          <div class="u-vdocont-desc-wrap">
            <div class="u-vdocont-desc-line"></div>
            <div class="u-vdocont-desc-text">{{ section.settings.cnt_desc }}</div>
          </div>
        {% endif %}
        {% if section.blocks.size > 0 %}
          <ul class="u-vdocont-usp-list">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'usp_item' %}
                  {% if block.settings.usp_txt != blank %}
                    <li class="u-vdocont-usp-item" {{ block.shopify_attributes }}>
                      <span class="u-vdocont-usp-icon" aria-hidden="true">
                        {% if block.settings.usp_icon_img != blank %}
                          <img
                            src="{{ block.settings.usp_icon_img | image_url: width: 60 }}"
                            width="100%"
                            height="100%"
                            loading="lazy"
                            alt=""
                          >
                        {% else %}
                          <svg
                            viewBox="0 0 16 16"
                            width="10"
                            height="10"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                          >
                            <path d="M13.5 4L6 11.5L2.5 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                          </svg>
                        {% endif %}
                      </span>
                      <span class="u-vdocont-usp-text">{{ block.settings.usp_txt }}</span>
                    </li>
                  {% endif %}
              {% endcase %}
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>
  </div>
</section>

