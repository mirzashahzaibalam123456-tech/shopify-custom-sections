}
{% endschema %}

<script>
  (function () {
    function toggleVideo(e) {
      var video = e.target.closest('.u-vdocont-video');
      if (video) {
        video.paused ? video.play() : video.pause();
        return;
      }
      var btn = e.target.closest('.u-vdocont-play-btn');
      if (!btn) return;
      var wrap = btn.closest('.u-vdocont-video-wrap');
      if (!wrap) return;
      var vid = wrap.querySelector('.u-vdocont-video');
      if (vid) vid.play();
    }

    function setPlaying(isPlaying) {
      return function (e) {
        if (!e.target.classList || !e.target.classList.contains('u-vdocont-video')) return;
        var wrap = e.target.closest('.u-vdocont-video-wrap');
        if (wrap) wrap.classList.toggle('u-vdocont-is-playing', isPlaying);
      };
    }

    document.addEventListener('click', toggleVideo);
    document.addEventListener('play', setPlaying(true), true);
    document.addEventListener('pause', setPlaying(false), true);
    document.addEventListener('ended', setPlaying(false), true);
  })();
</script>

